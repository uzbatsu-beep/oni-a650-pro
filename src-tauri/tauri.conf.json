{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONI A650 Configurator PRO",
  "version": "0.2.0-preview.6",
  "identifier": "com.oni.a650.configurator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ONI A650M — Инженерный конфигуратор PRO 2.0",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
